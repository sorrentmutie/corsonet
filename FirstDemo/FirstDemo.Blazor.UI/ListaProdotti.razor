@using FirstDemo.Blazor.UI.DataServices
@using FirstLibrary.Core.Northwind
@inject NavigationManager navigationManager

<h3>Lista Prodotti</h3>
<button @onclick="() => OnCreaProdotto.InvokeAsync()" class="btn btn-info">
    Crea Prodotto</button>
<br />

@if (Prodotti is not null && Prodotti.Any())
{
    <table class="table table-striped table-bordered table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Prezzo</th>
                <th>Giacenza</th>
                <th>Scorta Minima</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prodotto in Prodotti)
            {
                <tr>
                    <td>@prodotto.Nome</td>
                    <td>@(prodotto.PrezzoUnitario?.ToString("C") ?? "N/A")</td>
                    <td>@prodotto.Giacenza</td>
                    <td>@prodotto.ScortaMinima</td>
                    <td>
                        <button class="btn btn-info" @onclick="() => VaiADettaglio(prodotto)">Dettagli</button>
                        <button class="btn btn-warning" @onclick="() => OnModifica.InvokeAsync(prodotto)">Modifica</button>
                        <button class="btn btn-danger" @onclick="() => OnCancella.InvokeAsync(prodotto)">Cancella</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Non ci sono categorie</p>
}


@code {


    [Parameter]
    public List<ProdottoListitem>? Prodotti { get; set; }

    [Parameter]
    public EventCallback OnCreaProdotto { get; set; }

    [Parameter]
    public EventCallback<ProdottoListitem> OnModifica { get; set; }

    [Parameter]
    public EventCallback<ProdottoListitem> OnCancella { get; set; }


    private void VaiADettaglio(ProdottoListitem prodotto)
    {
       // navigationManager.NavigateTo($"dettagliocategoria/{categoria.CategoryId}");
    }
}

