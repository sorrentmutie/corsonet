@page "/orders/{id}"
@using FirstDemo.Blazor.UI.DataServices
@using FirstLibrary.Core.Common
@inject IServizioDettagliOrdini servizioDettOrdini
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@if (orderSummary is not null)
{
    <h3>ID Ordine: <span class="badge bg-success">@Id</span></h3>
    <h3>Totale Ordine: <span class="badge bg-success">€ @orderSummary.Totale.ToString("0.00")</span></h3>

    <QuickGrid Items="@orderSummary.Dettagli.AsQueryable()" Class="table table-bordered table-striped table-hover" Pagination="pagination">
        <PropertyColumn Title="Prodotto" Property="@(x=>x.NomeProdotto)" Sortable="true"></PropertyColumn>
        <PropertyColumn Title="Categoria" Property="@(x=>x.CategoriaProdotto)" Sortable="true"></PropertyColumn>
        <PropertyColumn Title="Fornitore" Property="@(x=>x.NomeFornitore)" Sortable="true"></PropertyColumn>
        <PropertyColumn Title="Qta" Property="@(x=>x.Quantita)"></PropertyColumn>
        <PropertyColumn Title="Prezzo (€)" Property="@(x=>x.PrezzoUnitario.ToString("0.00") )"></PropertyColumn>
        <PropertyColumn Title="Sconto (%)" Property="@(x=>(x.Sconto*100).ToString("0.##"))"></PropertyColumn>
        <PropertyColumn Title="Importo (€)" Property="@(x=>x.Importo.ToString("0.00"))"></PropertyColumn>
        @*         <TemplateColumn Context="cliente">
            <button class="btn btn-success" @onclick="()=>Dettaglio(cliente)">Vai a dettaglio</button>
            <button class="btn btn-warning" @onclick="()=>Modifica(cliente)">Modifica</button>
            <button class="btn btn-danger" @onclick="()=>Cancella(cliente)">Cancella</button>
        </TemplateColumn> *@


    </QuickGrid>

    <Paginator State="pagination" />

    <button class="btn btn-primary" @onclick="()=>GoBack()">Torna alla lista ordini</button>

}
else
{
    <h3>ID Ordine: <span class="badge bg-danger">@Id</span></h3>
}



@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    public OrderSummary? orderSummary { get; set; }

    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };


    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            orderSummary = await servizioDettOrdini.GetDettagliOrdine(int.Parse(Id));
        }
    }

    // Go back in browser using Javascript on a Razor Page
    private async Task GoBack()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }
}
