@page "/employees"
@using FirstLibrary.Core.Northwind
@using FirstLibrary.Core.Configurations
@using Microsoft.Extensions.Options
@inject IOptions<EndpointsNorthwindAPI> EndpointsOptions


<MyGenericSearchResults ApiAddress="@ApiAddress" TItem="Impiegato" ModalId="MySearchImp" DetailUrl="employees" />

@code {

    private string ApiAddress = string.Empty;

    protected override void OnInitialized()
    {
        if (EndpointsOptions != null)
        {
            ApiAddress = EndpointsOptions.Value?.Impiegati!;
        }
    }
}
