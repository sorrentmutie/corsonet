@page "/esperimenti"
@inject IJSRuntime JSRuntime
@inject IDatiMappa DatiMappa
@using FirstLibrary.Core.Mappe;
@rendermode InteractiveServer

<h3> Esperimenti</h3>



<Component1 />
<button class="btn btn-success" @onclick="Carica">OK</button> 
 @foreach (var item in ParametriMappe)
{
    <MyMap Parametri="@item" />
    <br />
}

@code {
    private List<ParametriMappa> ParametriMappe = new();
    private async Task Carica()
     {
        var interop = new ExampleJsInterop(JSRuntime);
        await interop.Prompt("Salvatore");
    }
    protected async override Task OnInitializedAsync()
    {
        ParametriMappe = await DatiMappa.GetParametriMappaAsync();
    }

    [JSInvokable]
    public static string PopupMappa(string id)
    {
        return "<b>Hello world! " + id + "</b><br/>";
    }
}
