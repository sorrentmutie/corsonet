@page "/"
@inject IConferenze servizioConferenze
@inject IJSRuntime jsRuntime

@using FirstDemo.Blazor.UI.Interop
@using FirstLibrary.Core.Conferenze

<PageTitle>Index</PageTitle>

<ListaEventi Eventi="eventiFuturi" Titolo="@titolo" OnEventoEliminato="EliminaEvento"/>
<MyModal Id="myModal" Title="Conferma cancellazione evento" OnNo="No" OnSi="Si">
    <Body>
        <p>Sei sicuro di voler rimuovere l'evento?</p>
    </Body>
</MyModal>

<button @onclick="() => CambiaTitolo()">Cambia Titolo</button>
<p>@servizioConferenze.NumeroConteggi</p>
<button class="btn btn-danger" @onclick="Saluta">Saluta Da JavaScript</button>

<button class="btn btn-warning" @onclick="InvocaJavaScript">Invoca Codice JavaScript</button>
@somma

@code {
    private string titolo = "Eventi futuri";
    private int somma = 0;

    private List<Evento>? eventiFuturi;
    private Evento? eventoSelezionato;
    private MyModalInterop? myModalInterop;

    protected override void OnInitialized()
    {
        eventiFuturi = servizioConferenze.EstraiEventiFuturi();
    }

    private async Task EliminaEvento(Evento evento)
    {
        // Bisogna far apparire la finestra Modale
        eventoSelezionato = evento;
        myModalInterop = new MyModalInterop(jsRuntime);
        await myModalInterop.ApriModale("myModal");
        // await jsRuntime.InvokeVoidAsync("mostraModale", "myModal");
        //eventiFuturi?.Remove(evento);
    }

    private void CambiaTitolo()
    {
        titolo += "!";  
    }

    private async Task Si()
    {
        if (eventoSelezionato is not null)
        {
            eventiFuturi?.Remove(eventoSelezionato);            
        }

        if (myModalInterop is not null)
        {
            await myModalInterop.ChiudiModale();
        }

      //  await jsRuntime.InvokeVoidAsync("chiudiModale");
        eventoSelezionato = null;

    }

    private async Task No()
    {
        if (myModalInterop is not null)
        {
            await myModalInterop.ChiudiModale();
        }
        eventoSelezionato = null;
    }

    private async Task InvocaJavaScript()
    {
        somma =  await jsRuntime.InvokeAsync<int>("somma", 3, 4);
        await jsRuntime.InvokeVoidAsync("saluta", "Mario");
    }

    private async Task Saluta()
    {
        //var helper = new HelloHelper("Salvatore");
        //var obj = DotNetObjectReference.Create(helper);
        //await jsRuntime.InvokeVoidAsync("ola", obj);
        var myInterop = new HelloInterop(jsRuntime);
        await myInterop.CallHelloHelper("Luisa");
    }


    [JSInvokable]
    public static string Saluta(string nome)
    {
        return $"Ciao da {nome}";
    }
}

