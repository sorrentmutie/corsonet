@using FirstLibrary.Core.Conferenze
<h3>@Titolo</h3>

@if(Eventi is not null)
{
<QuickGrid Items="@(Eventi.AsQueryable())" Class="table table-striped table-hover table-bordered"
   Pagination="@pagination">
        <PropertyColumn Title="Nome" Property="@(e => e.Nome)" Sortable="true" />
        <PropertyColumn Title="Luogo" Property="@(e => e.Luogo)" Sortable="true" />
        <PropertyColumn Title="Data di inizio" Property="@(e => e.DataInizio)" Sortable="true" />
        <TemplateColumn Context="evento">
            <button class="btn btn-danger" @onclick="() => OnEventoEliminato.InvokeAsync(evento)">Elimina</button>
        </TemplateColumn>
</QuickGrid>
<Paginator State="pagination" />
}



