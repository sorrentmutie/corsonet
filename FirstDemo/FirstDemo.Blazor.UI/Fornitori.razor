@using FirstLibrary.Core.Northwind
@using FirstLibrary.Core.Configurations
@using Microsoft.Extensions.Options
@inject IOptions<EndpointsNorthwindAPI> EndpointsOptions

<MyGenericSearchResults ApiAddress="@ApiAddress" TItem="Fornitore" ModalId="MySearchForn" />

@code {
    private string ApiAddress = string.Empty;

    protected override void OnInitialized()
    {
        if (EndpointsOptions != null)
        {
            ApiAddress = EndpointsOptions.Value?.Fornitori!;
        }
    }
}
