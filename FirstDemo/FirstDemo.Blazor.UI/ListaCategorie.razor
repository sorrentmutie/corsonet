@using FirstLibrary.Core.Northwind
@inject NavigationManager navigationManager

<h3>Lista Categorie</h3>
<button @onclick="() => OnCreaCategoria.InvokeAsync()" class="btn btn-info">Crea Categoria</button>
<br/>

@if (Categorie is not null && Categorie.Any())
{
    <table class="table table-striped table-bordered table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Descrizione</th>
                <th>Numero Prodotti</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Categorie)
            {
                <tr>
                    <td>@categoria.Nome</td>
                    <td>@categoria.Descrizione</td>
                    <td>@categoria.NumeroProdotti</td>
                    <td>
                        <button class="btn btn-info" @onclick="() => VaiADettaglio(categoria)">Dettagli</button>
                        <button class="btn btn-warning" @onclick="() => OnModifica.InvokeAsync(categoria)"  >Modifica</button>
                        <button class="btn btn-danger" @onclick="() => OnCancella.InvokeAsync(categoria)">Cancella</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Non ci sono categorie</p>
}


@code {


    [Parameter]
    public List<Categoria>? Categorie { get; set; } 

    [Parameter]
    public EventCallback OnCreaCategoria { get; set; }

    [Parameter]
    public EventCallback<Categoria> OnModifica { get; set; }

    [Parameter]
    public EventCallback<Categoria> OnCancella { get; set; }


    private void VaiADettaglio(Categoria categoria)
    {
        navigationManager.NavigateTo($"dettagliocategoria/{categoria.CategoryId}");
    }
}
