﻿<div class="modal" tabindex="-1" id="@Id">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Body
            </div>
            <div class="modal-footer">
                @if(ShowSiNo)
                {
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="() => OnNo.InvokeAsync()">No</button>
                    <button type="button" class="btn btn-primary" @onclick="() => OnSi.InvokeAsync()">Si</button>
                }
                @if(ShowOk)
                {
                    <button type="button" class="btn btn-primary" @onclick="() => OnOk.InvokeAsync()">Ok</button>
                }

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "myModal";
    [Parameter] public string Title { get; set; } = "Modal title";
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public EventCallback OnSi { get; set; }
    [Parameter] public EventCallback OnNo { get; set; }
    [Parameter] public EventCallback OnOk{ get; set; }
    [Parameter] public bool ShowSiNo { get; set; } = false;
    [Parameter] public bool ShowOk { get; set; } = false;
}