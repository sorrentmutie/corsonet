@using FirstLibrary.Core.Northwind
@using Microsoft.AspNetCore.Components.Forms
@typeparam TItem where TItem : class, new()

<h3>Dettaglio</h3>



@if (Item is not null)
{
    <EditForm Model="@Item" OnValidSubmit="@(() => OnSalva.InvokeAsync(Item))">

        <DataAnnotationsValidator />

        @if (ChildContent is not null)
        {
            @ChildContent(Item)
        }


        <div class="mt-3">
            <button type="submit" class="btn btn-info">OK</button>
            <button type="button" @onclick="() => OnAnnulla.InvokeAsync()" class="btn btn-danger">Annulla</button>
        </div>


    </EditForm>
}





@code {
    [Parameter]
    public TItem? Item { get; set; }

    [Parameter]
    public EventCallback<TItem> OnSalva { get; set; }

    [Parameter]
    public EventCallback OnAnnulla { get; set; }

    [Parameter]
    public RenderFragment<TItem>? ChildContent { get; set; }

}
