@page "/dashboard"
@using DemoAuth.Data
@using FirstDemo.Blazor.UI.Interop
@using FirstDemo.Blazor.UI.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using FirstDemo.Blazor.UI
@using FirstDemo.UI.Kit.Components
@rendermode InteractiveServer
@inject RoleManager<IdentityRole> RoleManager
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JSRuntime

@* @attribute [Authorize(Roles="Admin")] *@
<h3>Dashboard</h3>
<button class="btn btn-success" @onclick="() => CreaRuolo()">Crea un ruolo</button>
<button class="btn btn-success" @onclick="() => AssegnaRuoloAdUtente()">Assegna ruolo ad utente</button>
<button class="btn btn-success" @onclick="() => AssegnaClaimAdUtente()">Assegna ruolo ad utente</button>

<MyModal Id="Ruolo" Title="Gestione ruolo">
    <Body>

        <Dettaglio Item="RuoloScelto" TItem="Ruolo" OnSalva="Salva"  OnAnnulla="Annulla">
            <ChildContent>
                <MyInputTextBox @bind-Value="RuoloScelto.Nome" Label="Nome" />  
            </ChildContent>
        </Dettaglio>

    </Body> 

</MyModal>

<MyModal Id="UtenteRuolo" Title="Assegnazione ruolo a utente">
    <Body>

        <Dettaglio Item="ruoloUtente" TItem="RuoloUtente" OnSalva="SalvaRuoloUtente" OnAnnulla="AnnullaRuoloUtente">
            <ChildContent>
                <MyInputTextBox @bind-Value="ruoloUtente.Email" Label="Email utente" />
                <MyInputTextBox @bind-Value="ruoloUtente.Ruolo" Label="Ruolo" />
            </ChildContent>
        </Dettaglio>

    </Body>

</MyModal>

<p>@resultMessage</p>

@code {
    private MyModalInterop? myModalInterop;
    Ruolo RuoloScelto=new();
    RuoloUtente ruoloUtente = new();

    string resultMessage = string.Empty;
    // protected override async Task OnInitializedAsync()
    // {
    //     await base.OnInitializedAsync();
    //     myModalInterop = new MyModalInterop(JSRuntime); 
    // }

    private void Annulla()
    {
        RuoloScelto = new();
        myModalInterop?.ChiudiModale();
    }   

    private void AnnullaRuoloUtente()
    {
       ruoloUtente = new();
        myModalInterop?.ChiudiModale();
    }

    private async Task SalvaRuoloUtente(RuoloUtente ru)
    {
        var utente = await UserManager.FindByEmailAsync(ru.Email);

        if (utente is not null)
        {
            await UserManager.AddToRoleAsync(utente, ru.Ruolo);
        }
            

        ruoloUtente = new();
        myModalInterop?.ChiudiModale();
    }

    private async Task Salva(Ruolo ruolo)
    {
        
        var esiste = await RoleManager.RoleExistsAsync(ruolo.Nome);
        if(!esiste)
        {
            var role = new IdentityRole { Name = ruolo.Nome };
            var result = await RoleManager.CreateAsync(role);
            resultMessage = result.Succeeded ? "Ruolo creato" : "Errore nella creazione del ruolo"; 
        }
        RuoloScelto = new();
        myModalInterop?.ChiudiModale();
    }

    protected override void OnInitialized()
    {

        myModalInterop = new MyModalInterop(JSRuntime);
    }

    private async Task AssegnaClaimAdUtente()
    {
        string mail = "salvatore.sorrentino@live.com";

        var utente = await UserManager.FindByEmailAsync(mail);

        if (utente is not null)
        {
            var claim = new Claim(
                ClaimTypes.Country, "Italia");

            await UserManager.AddClaimAsync(utente, claim);
        }
    }

    private void AssegnaRuoloAdUtente()
    {
       
        myModalInterop?.ApriModale("UtenteRuolo");

    }

    private void CreaRuolo()
    {
 
        myModalInterop?.ApriModale("Ruolo");
    }
}
