@page "/items"
@rendermode InteractiveAuto


<h3>Items</h3>

<div class="row">
    <div class="form-group col-4">
        <label class="form-label" for="name">Name:</label>
        <input class="form-control" id="name" @bind-value="@itemName" />
    </div>

    <div class="form-group col-4">
        <label class="form-label" for="name">Price:</label>
        <input class="form-control" id="name" @bind-value="@price" />
    </div>

    <div class="col-4 align-self-end">
        <button type="button" class="btn btn-primary" @onclick="AddItem">Add Item</button>
    </div>

</div>

@CartState.Value.Items.Count() 


@if (CartState.Value.Items.Any())
{
    @foreach (var item in CartState.Value.Items)
    {
        <p>@item.Name @item.Price</p>
    }
}



