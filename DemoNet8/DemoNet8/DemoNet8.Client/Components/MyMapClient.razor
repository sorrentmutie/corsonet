
@using FirstDemo.Blazor.UI.Interop
@using FirstDemo.UI.Kit.Maps
@inject IJSRuntime JSRuntime
@rendermode InteractiveWebAssembly

@if (Parametri is not null)
{
    <div id="@Parametri.Id" style="height: 180px;"></div>
}



@code {
    [Parameter]
    public ParametriMappa? Parametri { get; set; }
   
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Parametri is not null)
        {
            var interop = new MyMapInterop(JSRuntime);

            if (firstRender)
            {

                await interop.MostraMappa(Parametri.Id, Parametri.Latitudine, Parametri.Longitudine, Parametri.Zoom);
            }
            else
            {
                await interop.AggiornaMappa(Parametri.Id, Parametri.Latitudine, Parametri.Longitudine, Parametri.Zoom);
            }
        }
    }
}
