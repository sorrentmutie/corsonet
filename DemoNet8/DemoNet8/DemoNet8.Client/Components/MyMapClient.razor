@using FirstLibrary.Core.Mappe
@using FirstDemo.Blazor.UI.Interop
@inject IJSRuntime JSRuntime
@rendermode InteractiveWebAssembly

@if (Parametri is not null)
{
    <div id="@Parametri.Id" style="height: 180px;"></div>
}



@code {
    [Parameter]
    public ParametriMappa? Parametri { get; set; }
   
    // [Parameter]
    // public string Id { get; set; } = "MyMappa";
    // [Parameter]
    // public float Latitudine { get; set; } = 0;
    // [Parameter]
    // public float Longitudine { get; set; } = 0;
    // [Parameter]
    // public int Zoom { get; set; } = 13;





    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Parametri is not null)
        {
            var interop = new FirstDemo.Blazor.UI.Interop.MyMapInterop(JSRuntime);

            if (firstRender)
            {

                await interop.MostraMappa(Parametri.Id, Parametri.Latitudine, Parametri.Longitudine, Parametri.Zoom);
            }
            else
            {
                await interop.AggiornaMappa(Parametri.Id, Parametri.Latitudine, Parametri.Longitudine, Parametri.Zoom);
            }
        }
    }
}
