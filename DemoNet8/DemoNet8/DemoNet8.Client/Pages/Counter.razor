@page "/counter-client"
@rendermode InteractiveAuto
@inject IDatiMappa DatiMappa
@using DemoNet8.Client.Components
@using FirstDemo.UI.Kit.Maps

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

 @foreach (var item in ParametriMappe)
{
    <MyMapClient Parametri="@item" />
    <br />
}

@code {
    private int currentCount = 0;
    private List<ParametriMappa> ParametriMappe = new();

    private void IncrementCount()
    {
        currentCount++;
    }

    protected async override Task OnInitializedAsync()
    {
        ParametriMappe = await DatiMappa.GetParametriMappaAsync();
    }
}
